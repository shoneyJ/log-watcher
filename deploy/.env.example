# Environment for the log-watcher MCP server (log-watcher-mcp.service
# loads this via EnvironmentFile=). Copy to /opt/log-watcher/.env and
# restrict it: chown root:log-watcher, chmod 640.

# Bearer token every MCP request must present. Keep it out of
# config.json so the config can be world-readable. Generate one:
#   openssl rand -hex 32
LOG_WATCHER_API_KEY=change-me
